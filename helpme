#!/bin/bash

NannyBotDir=${NannyBotDir:-$(dirname "$(readlink -f "$0")")}
# shellcheck source=lib.sh
. "$NannyBotDir/lib.sh"

#check if prompt exists
if [[ -f $NannyBotDir/current_prompt ]]; then
	"$NannyBotDir/current_prompt"
	exit
fi

option=$(printf '%s\n' "1 Who are you?" "2 So do I call you Betty or... " "3 How am I suppose to use you exactly?" "4 What is the recomended setup for you?" "5 What else should I know?" "6 Are you running right now?" | menu "Nannybot here, how can I help?")

case "${option:0:1}" in
	1)
		notify default "Why I'm Nannybot! The name of this particular module you're running is called \"Betty\" Nice to meet you! " 60000
		;;
	2)
		notify default "Either is perfectly fine, Betty is the face, nannybot is the underlying structure that makes me run. If you're wondering where my design comes from, I was drawn by wwwjam, and I'm based on a comic series called \"Emmy The Robot\", that's owned by the wonderful Domcell (That you should totally read by the way!)" 60000
		;;
	3)
		notify default "I'm a task managing system daemon, that helps you manager you daily life! I can remind you of certian tasks, or things you need to do on certian days. I can help you remember birthdays, remind you to work on that one project you keep putting off, or even just to take out the trash!" 60000
		;;
	4)
		notify default "Andrew, my creator, Recomends that you add me to your startup programs, and have a hotkey mapped to run the 'summon' script. It doesn't matter what hotkey, just as long as it's one that's convenient for you." 60000
		;;
	5)
		notify assuring "Checkout the README.md for information on how my messaging system works!" 60000
		;;
	6)
		if bot_running; then
			notify smug "Yes I am! But I'd suggest you got make some custom messages for me to send to you, if you haven't already! Go check out the README.md to get more info on how to do that." 60000
		else
			notify smug "No I am not running right now, You can't start me without having some custom messages for me to send to you! Go check out the README.md to get more info on making some!" 60000
		fi
		;;
	*)
		notify thinking "I'm sorry sweetie, can you say that again?" 60000
		;;
esac
