#!/bin/bash

#runs through the current_prompt symlink, readlink -f resolves it back to prompts/
NannyBotDir=${NannyBotDir:-$(dirname "$(dirname "$(readlink -f "$0")")")}
# shellcheck source=../lib.sh
. "$NannyBotDir/lib.sh"

mood=$(printf '%s\n' "1 very good" "2 alright" "3 ready to work!" "4 tired" "5 sad" "6 angry" | menu)

case "${mood:0:1}" in
	1)
		notify default "Glad to hear!"
		;;
	2)
		notify assuring "Well, if you need anything, I'm right here love."
		;;
	3)
		notify assuring "That's my boy."
		;;
	4)
		notify thinking "Most adults are suggested to get between 6 and 8 hours a night. If you're getting more or less it can be difficult to function."
		;;
	5)
		notify sad "I wish I could do something more for you."
		;;
	6)
		notify sad "Just take a deep breath and talk it out, that might help some."
		;;
	*)
		notify default "I'm sorry, can you say that again?"
		#did not answer prompt correctly, keep current_prompt
		exit
		;;
esac

rm -f "$NannyBotDir/current_prompt"
