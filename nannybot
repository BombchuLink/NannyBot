#!/bin/bash

NannyBotDir=${NannyBotDir:-$(dirname "$(readlink -f "$0")")}
# shellcheck source=lib.sh
. "$NannyBotDir/lib.sh"

if bot_running; then
	echo "NannyBot is already running (pid $(<"$pidfile"))"
	exit 1
fi
echo $$ >"$pidfile"

cleanup() {
	kill "$reminder_pid" "$_nap" 2>/dev/null
	rm -f "$pidfile"
}
trap cleanup EXIT
trap 'exit 0' TERM INT
#summon sends USR1 to show the next notice right now
trap 'forced=1; kill "$_nap" 2>/dev/null' USR1

echo "Name is $UName"

#boot message
if [[ ! -f $NannyBotDir/botlog ]]; then
	#first run ever
	touch "$NannyBotDir/botlog"
	notify default "Hi there! I'm NannyBot v$VERSION! I'm here to help you organize your life and help you through thick and thin

If you haven't done so already, run the 'helpme' script in this folder, and please check out the README.md for full documentation on how I can help you!" 60000
elif [[ -f $state/reboot ]]; then
	notify default "Successfully rebooted!" 60000
	rm -f "$state/reboot"
elif (( 10#$(date +%H) > 12 )); then
	"$NannyBotDir/scripts/greetinglate"
else
	"$NannyBotDir/scripts/greetingmsg"
fi
# TODO add ability to check for other boot messages

# TODO start script that monitors files/day/active time/ect (shutdown monitoring goes here)

#start timed reminders script
"$NannyBotDir/scripts/remindermanager" &
reminder_pid=$!

#print one weighted-random line from noticespool whose time window contains now
#window is All, or HH:MM-HH:MM (can wrap past midnight, e.g. 22:00-2:00)
pick_notice() {
	awk -v now="$(minute_of_day)" -v seed="$RANDOM" '
		function mins(s, t) { split(s, t, ":"); return t[1] * 60 + t[2] }
		$1 ~ /^[0-9]+$/ {
			if ($2 != "All") {
				split($2, win, "-")
				s = mins(win[1]); e = mins(win[2])
				if (s <= e ? (now < s || now >= e) : (now < s && now >= e)) next
			}
			w[++n] = $1; line[n] = $0; total += $1
		}
		END {
			if (!total) exit 1
			srand(seed); r = int(rand() * total)
			for (i = 1; i <= n; i++) if ((r -= w[i]) < 0) { print line[i]; exit }
		}
	' "$NannyBotDir/messages/noticespool"
}

#notifications loop
while true; do
	waittime=$(( Mtime + (Vtime > 0 ? RANDOM % Vtime : 0) ))
	echo "sleeping for $waittime minutes"
	forced=0
	nap $(( waittime * 60 ))

	if [[ -f $state/quiet ]] && (( ! forced )); then
		echo "bot is quiet for now, skipping notice"
		continue
	fi

	if ! line=$(pick_notice); then
		notify thinking "I'm sorry, but it looks like I don't have any tips in the notifcation pool right now."
		continue
	fi
	read -r _ _ icon rest <<<"$line"
	deliver "$icon" "$rest"
done

