#!/bin/bash

NannyBotDir=${NannyBotDir:-$(dirname "$(dirname "$(readlink -f "$0")")")}
# shellcheck source=../lib.sh
. "$NannyBotDir/lib.sh"

reminders="$NannyBotDir/messages/reminders"
trap 'kill "$_nap" 2>/dev/null; exit 0' TERM INT

#print "minute<TAB>line" for every reminder that applies today (boot reminders get minute -1)
#Day can be All, a day (Mon), a range (Mon-Fri), or a date (2/25/21, 02/25/21, 2/25/XX)
today_reminders() {
	local dname wday mon mday year
	read -r dname wday mon mday year <<<"$(LC_ALL=C date '+%a %w %m %d %y')"
	awk -v dname="$dname" -v wday="$wday" -v mon="$mon" -v mday="$mday" -v year="$year" '
		BEGIN { split("Sun Mon Tue Wed Thu Fri Sat", names, " "); for (i in names) idx[names[i]] = i - 1 }
		function mins(s, t) { split(s, t, ":"); return t[1] * 60 + t[2] }
		function day_ok(d, t, a, b) {
			if (d == "All" || d == dname) return 1
			if (d ~ /\//) {
				split(d, t, "/")
				return t[1] + 0 == mon + 0 && t[2] + 0 == mday + 0 && (t[3] == "XX" || t[3] % 100 == year + 0)
			}
			if (split(d, t, "-") == 2 && (t[1] in idx) && (t[2] in idx)) {
				a = idx[t[1]]; b = idx[t[2]]
				return a <= b ? (wday >= a && wday <= b) : (wday >= a || wday <= b)
			}
			return 0
		}
		/^[[:space:]]*#/ || NF < 4 { next }
		day_ok($2) { print ($3 == "boot" ? -1 : mins($3)) "\t" $0 }
	' "$reminders"
}

fire() {
	local line=$1 type icon rest n
	local -a intros=("$UName, I need to remind you" "$UName, Here's your reminder" "Hey $UName, Don't forget")
	read -r type _ _ icon rest <<<"$line"
	deliver "$icon" "$rest" "${intros[RANDOM % ${#intros[@]}]}"

	#remove message if Temp
	if [[ $type == Temp ]]; then
		n=$(grep -nxF -m1 -- "$line" "$reminders" | cut -d: -f1)
		[[ -n $n ]] && sed -i "${n}d" "$reminders"
	fi
}

#on start, skip anything earlier today; after midnight, start from 00:00
#if the computer was asleep, reminders missed since the last check are sent on wake
today=$(date +%F)
cursor=$(minute_of_day)
boot_at=$(( $(date +%s) + 120 ))
boot_done=0

while true; do
	if [[ $(date +%F) != "$today" ]]; then
		today=$(date +%F)
		cursor=0
	fi
	now=$(minute_of_day)
	boot_due=$(( ! boot_done && $(date +%s) >= boot_at ))

	while IFS=$'\t' read -r min line; do
		if (( min < 0 ? boot_due : (min >= cursor && min <= now) )); then
			fire "$line" </dev/null
		fi
	done < <(today_reminders)

	(( boot_due )) && boot_done=1
	cursor=$(( now + 1 ))
	#wake at the top of the next minute
	nap $(( 60 - 10#$(date +%S) ))
done
